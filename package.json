{
  "name": "american-mahjong-dealer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "American Mahjong Dealer — implementation workspace",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "pnpm --filter @mahjong-dealer/server run start",
    "db:migrate": "pnpm --filter @mahjong-dealer/db run migrate",
    "provision:admin": "pnpm --filter @mahjong-dealer/server run provision:admin"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
